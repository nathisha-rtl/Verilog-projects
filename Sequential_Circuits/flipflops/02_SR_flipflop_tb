module SR_flipflop_tb;
  wire Q,Q_bar;
  reg S,R,clk;
  
  SR_flipflop uut(.S(S),
                  .R(R),
                  .clk(clk),
                  .Q(Q),
                  .Q_bar(Q_bar));
  
  always #5 clk = ~clk;
  
  initial begin
    
    $monitor("$time=%0t | S=%b | R=%b | Q=%b | Q_bar=%b " , $time , S , R , Q , Q_bar);
    $dumpfile("SR_flipflop.vcd");
    $dumpvars(0,SR_flipflop_tb);
    
    clk =0;
    S=1 ; R=0 ; #10;
  
    S=0 ; R=0 ; #10;
    
  
    S=1 ; R=0 ; #10;
    
    S=0 ; R=1 ; #10;
   
    S=1 ; R=0 ; #10;
    
    S=1 ; R=1 ; #10;
    $finish;
  end
endmodule
